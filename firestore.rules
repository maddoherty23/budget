rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if the incoming data has valid userId
    function hasValidUserId() {
      return request.resource.data.userId == request.auth.uid;
    }
    
    // Users collection - users can only access their own data
    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Budgets collection - user-scoped access
    match /budgets/{budgetId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && hasValidUserId();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Transactions collection - user-scoped access
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && hasValidUserId();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Categories collection - user-scoped access
    match /categories/{categoryId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && hasValidUserId();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Custom categories collection - user-scoped access
    match /customCategories/{categoryId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && hasValidUserId();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Deleted categories collection - user-scoped access
    match /deletedCategories/{categoryId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && hasValidUserId();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Connected accounts collection - user-scoped access
    match /connectedAccounts/{accountId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && hasValidUserId();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Plaid items collection - user-scoped access
    match /plaidItems/{itemId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && hasValidUserId();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Savings goals collection - user-scoped access
    match /savingsGoals/{goalId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && hasValidUserId();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // User preferences collection - user-scoped access
    match /userPreferences/{prefId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && hasValidUserId();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ========================================================================
    // Cash Runway Collections
    // ========================================================================
    
    // Cash Plans - one per user, keyed by userId
    match /cashPlans/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Bill Templates - user-scoped access
    match /billTemplates/{templateId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && hasValidUserId();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Bill Instances - user-scoped access
    match /billInstances/{instanceId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && hasValidUserId();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Planned Spending - user-scoped access
    match /plannedSpending/{spendingId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && hasValidUserId();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Cash Forecasts - read-only for users, backend writes only
    match /cashForecasts/{forecastId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Only backend can write
    }
    
    // Alerts - user-scoped access
    match /alerts/{alertId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && hasValidUserId();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Recommendations - read-only for users, backend writes only
    match /recommendations/{recId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Only backend can write
    }
    
    // Bill Matches - user access through linked bills
    match /billMatches/{matchId} {
      allow read, write: if isAuthenticated();
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
